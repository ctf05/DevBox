# /etc/zsh/zshrc — system-wide interactive zsh config.
# Mirrors the Pop!_OS laptop setup from the dotfiles repo.

# ── History ────────────────────────────────────────────────────────
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS

# ── Completion ─────────────────────────────────────────────────────
autoload -Uz compinit
compinit -u

# ── Plugins (apt-installed in Dockerfile) ──────────────────────────
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#a5ff7e,bold'
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#ffb52e,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#ffb52e,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#ffb52e,bold'

# ── Tool integrations ──────────────────────────────────────────────
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"
command -v atuin  >/dev/null && eval "$(atuin init zsh)"
command -v mise   >/dev/null && eval "$(mise activate zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

# ── Stray terminal replies never reach the line editor ─────────────
# A terminal's answer to a capability query (DA1 "ESC [ ? … c", DA2
# "ESC [ > … c", XTVERSION "ESC P > | … ESC \") is delivered as *input*. If it
# arrives when nothing is waiting for it — a late answer, or the Superset app
# replaying a saved pane stream that still contains the query — it lands in
# ZLE, where the printable part becomes text and stray control bytes fire
# whatever widget they happen to be bound to. That is what used to fill the
# first prompt after `dev <session>` with escape-sequence soup.
#
# /usr/local/bin/ttyguard strips these from the tmux path; these bindings cover
# the paths it doesn't (a bare `ssh dev` with no tmux, DEVBOX_TTYGUARD=0). Both
# prefixes are responses that no key on any keyboard produces, so swallowing
# them cannot eat real input.
_devbox_eat_csi_reply() {
  local byte
  while read -t 0.2 -k 1 byte; do
    [[ $byte == [[:alpha:]] ]] && break   # CSI final byte ends the response
  done
}
_devbox_eat_dcs_reply() {
  local byte prev=
  while read -t 0.2 -k 1 byte; do
    [[ $prev == $'\e' && $byte == '\' ]] && break   # ST ends the response
    [[ $byte == $'\a' ]] && break                   # …or BEL, on some terminals
    prev=$byte
  done
}
zle -N _devbox_eat_csi_reply
zle -N _devbox_eat_dcs_reply
for _devbox_keymap in main vicmd; do
  bindkey -M "$_devbox_keymap" '\e[?' _devbox_eat_csi_reply
  bindkey -M "$_devbox_keymap" '\e[>' _devbox_eat_csi_reply
  bindkey -M "$_devbox_keymap" '\eP'  _devbox_eat_dcs_reply
done
unset _devbox_keymap

# ── fzf ────────────────────────────────────────────────────────────
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && \
  source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && \
  source /usr/share/doc/fzf/examples/completion.zsh

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border \
  --color=fg:#ffffff,bg:#171717,hl:#ffe100 \
  --color=fg+:#ffffff,bg+:#252525,hl+:#ffe100 \
  --color=info:#0dfff8,prompt:#ff56d3,pointer:#ff3d7f \
  --color=marker:#7dff3e,spinner:#c76bff,header:#5d5d5d'

# ── Aliases (parity with shared.nix) ───────────────────────────────
alias ls='eza --icons=auto'
alias ll='eza -la --icons=auto --git'
alias lt='eza --tree --icons=auto --level=2'
alias cat='bat'
alias gd='git diff'
alias vim='nvim'
alias v='nvim'
alias lg='lazygit'
alias y='yazi'
alias grep='rg'
alias find='fd'
alias diff='difft'
alias du='dust'
alias top='btop'
alias htop='btop'

# ── Local wall-clock, on demand ────────────────────────────────────
# The box is pinned to UTC (see zshenv), so `date` no longer answers "what
# time is it here". `now` does, reading the zone from DEVBOX_LOCAL_TZ so this
# public image never hardcodes the operator's geography — which is the exact
# thing pinning UTC was meant to stop leaking. Set it per-container via
# `docker run -e DEVBOX_LOCAL_TZ=...` if you want it; unset, `now` is just UTC.
now() { TZ="${DEVBOX_LOCAL_TZ:-UTC}" date; }

# ── yy: cd-into-yazi-cwd-on-exit ───────────────────────────────────
yy() {
  local tmp
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# ── claude-swap: account rotation at a glance ──────────────────────
# The entrypoint runs `cswap auto` in the background (threshold/strategy from
# CSWAP_* container env). `cswap` alone opens the dashboard, `cswap list` shows
# every account's 5h/7d usage. `cslog` follows the auto-switcher's decisions —
# switches highlighted, routine per-tick events (poll / no-switch / sleep)
# dropped; pass -a to show those too.
cslog() {
  local all=0
  [[ "${1:-}" == "-a" ]] && all=1
  tail -n 200 -F /var/log/cswap.log | jq --unbuffered -rR --argjson all "$all" '
    (fromjson? // .) as $e
    | if ($e | type) != "object" then $e
      elif ($all == 0) and ($e.event | IN("poll", "no-switch", "sleep")) then empty
      elif $e.event == "switch" then
        "\u001b[38;2;125;255;62m\($e.ts)  SWITCH  \($e.from.email // "?") → \($e.to.email // "?")  (\($e.trigger // ""))\u001b[0m"
      else
        "\($e.ts)  \($e.event)  \([$e.email, $e.reason, $e.detail, $e.message] | map(select(. != null and . != "")) | join("  "))"
      end'
}

# ── Secrets (optional, off by default in container) ────────────────
[[ -f "${HOME}/.secrets" ]] && source "${HOME}/.secrets"
