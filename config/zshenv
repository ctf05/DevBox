# /etc/zsh/zshenv — sourced for every zsh invocation, before /etc/zsh/zshrc
# Point tools at their system-wide config locations so updates to the image
# take effect without copying anything to /home/dev.

# ── Time posture ───────────────────────────────────────────────────
# UTC is pinned image-wide (see Dockerfile ENV and entrypoint.sh). It is
# re-asserted here because sshd starts login shells in a clean environment,
# so the image's ENV never reaches an interactive session — the same reason
# PLAYWRIGHT_BROWSERS_PATH is set below. Without this, `git`, `date` and
# every generator run from a shell would format with a local offset again.
export TZ=UTC

# SOURCE_DATE_EPOCH pins the current day at midnight UTC. Build tools that
# honour the reproducible-builds convention (tar, gzip, many bundlers) use it
# instead of the live clock for embedded timestamps, so archives stop
# carrying the minute they were produced. Tools that ignore it need the
# `pinclock` wrapper, which reads this same value so the two never disagree.
#
# UTC days begin on exact multiples of 86400, so truncating the epoch is the
# entire calculation — no date parsing, no DST edge case. Computed per shell
# rather than baked at boot so it doesn't go stale across midnight on a box
# that stays up for weeks.
zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
if [[ -n "${EPOCHSECONDS:-}" ]]; then
  export SOURCE_DATE_EPOCH=$(( EPOCHSECONDS - EPOCHSECONDS % 86400 ))
fi

export STARSHIP_CONFIG=/etc/starship/config.toml
export ATUIN_CONFIG_DIR=/etc/atuin
export LAZYGIT_CONFIG_DIR=/etc/lazygit
export YAZI_CONFIG_HOME=/etc/yazi

# Playwright browsers live at a fixed system-wide path (see Dockerfile). The
# image's `ENV PLAYWRIGHT_BROWSERS_PATH` reaches PID 1 but NOT sshd login shells
# (sshd starts them in a clean env), so without this every `playwright`/`pnpm
# e2e` fell back to $HOME/.cache/ms-playwright — which is empty or stale, and
# whose location shifts with $HOME (e.g. /home/dev vs the Mutagen-synced
# /home/popper-mobile). Exporting it here makes browser resolution deterministic
# and HOME-independent for all zsh sessions and the node/pnpm processes they spawn.
export PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Local bins for tools installed under the dev user (npm globals, pipx, etc.)
typeset -U path
path=("$HOME/.local/bin" $path)
export PATH

# Runtime-injected env, written by the entrypoint from container env vars that
# must reach SSH sessions. sshd starts login shells in a clean environment and
# doesn't propagate its own env, so these are bridged through this file instead.
[[ -f /etc/zsh/env.runtime ]] && source /etc/zsh/env.runtime
